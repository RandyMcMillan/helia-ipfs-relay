{
  "name": "helia-ipfs-relay",
  "private": true,
  "type": "module",
  "description": "Complete Helia IPFS relay — in-browser node (static page), optional headless shared backend (server.js), and a git-remote-gnostr helper for cloning repos announced on the gnostr pubsub topic",
  "scripts": { "start": "node server.js" },
  "engines": { "node": ">=22" },
  "dependencies": {
    "libp2p": "3.5.1",
    "@libp2p/tcp": "11.0.32",
    "@libp2p/websockets": "10.1.25",
    "@libp2p/noise": "17.0.7",
    "@libp2p/yamux": "8.0.7",
    "@libp2p/identify": "4.1.18",
    "@libp2p/ping": "3.1.17",
    "@libp2p/bootstrap": "12.0.36",
    "@libp2p/kad-dht": "16.4.9",
    "@libp2p/circuit-relay-v2": "4.2.17",
    "@libp2p/gossipsub": "15.0.23",
    "@libp2p/autonat": "3.0.32",
    "@libp2p/dcutr": "3.0.32",
    "@multiformats/multiaddr": "13.0.3",
    "@isomorphic-git/cors-proxy": "3.0.3",
    "helia": "7.1.16",
    "@helia/unixfs": "8.0.9"
  }
}
